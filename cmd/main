#!/bin/bash
# music-meta-web 生命周期：start / stop / status
# 应用监听 Unix Socket（$TRIM_APPDEST/app.sock），由 fnOS 统一网关转发 /app/music-meta-web

LOG_FILE="${TRIM_PKGVAR:-/var/apps/music-meta-web/var}/info.log"
PID_FILE="${TRIM_PKGVAR:-/var/apps/music-meta-web/var}/app.pid"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/music-meta-web/var}"
DEST_DIR="${TRIM_APPDEST:-/var/apps/music-meta-web/target}"
SOCK_FILE="${DEST_DIR}/app.sock"

# Python 运行时：优先飞牛 python311 应用，回退系统 python3
if [ -x "/vol1/@appcenter/python311/bin/python3" ]; then
    PYTHON="/vol1/@appcenter/python311/bin/python3"
else
    PYTHON="$(command -v python3 || echo /usr/bin/python3)"
fi

VENV_DIR="${VAR_DIR}/venv"
REQ_FILE="${DEST_DIR}/server/requirements.txt"
# 依赖轮子随 fpk 内置（CI 打包时下载，见 scripts/vendor-wheels.sh），
# 正常路径下装完即用、全程不联网。
WHEELS_DIR="${DEST_DIR}/server/vendor/wheels"
# 音频指纹要用的 fpcalc 也随包内置（CI 打包时下载，见 scripts/vendor-fpcalc.sh），
# 所以 NAS 上不需要用户自己 apt 装 libchromaprint-tools。
FPCALC_DIR="${DEST_DIR}/server/vendor/bin"
LOCK_FILE="${DEST_DIR}/server/requirements.lock.txt"
DEPS_CHECK="import fastapi, uvicorn, mutagen, multipart"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

run_as_user() {
    # cmd/main 由系统调用；root 时降权到包用户运行，非 root 直接执行
    if [ "$(id -u)" = "0" ] && [ -n "${TRIM_USERNAME:-}" ]; then
        runuser -u "${TRIM_USERNAME}" -- "$@"
    else
        "$@"
    fi
}

deps_ok() {
    run_as_user "${VENV_DIR}/bin/python" -c "${DEPS_CHECK}" 2>/dev/null
}

install_deps_offline() {
    # 只用包内轮子：--no-index 是显式断网开关，绝不会偷偷回落到网络索引。
    if [ ! -d "${WHEELS_DIR}" ]; then
        log_msg "内置轮子目录不存在：${WHEELS_DIR}"
        return 1
    fi
    local count
    count="$(find "${WHEELS_DIR}" -maxdepth 1 -name '*.whl' 2>/dev/null | wc -l)"
    if [ "${count}" -eq 0 ]; then
        log_msg "内置轮子目录为空：${WHEELS_DIR}"
        return 1
    fi
    local spec="${REQ_FILE}"
    [ -f "${LOCK_FILE}" ] && spec="${LOCK_FILE}"
    log_msg "离线安装依赖：${count} 个内置轮子（$(basename "${spec}")）"
    run_as_user env PIP_DISABLE_PIP_VERSION_CHECK=1 \
        "${VENV_DIR}/bin/python" -m pip install \
        --no-index --find-links "${WHEELS_DIR}" --no-cache-dir \
        --disable-pip-version-check -r "${spec}" >> "${LOG_FILE}" 2>&1
}

install_deps_online() {
    # 最后兜底：仅当内置轮子缺失、或与当前 Python ABI 不匹配（如换了大版本解释器）时才走网络
    for MIRROR in \
        "https://mirrors.cloud.tencent.com/pypi/simple" \
        "https://repo.huaweicloud.com/repository/pypi/simple" \
        "https://pypi.tuna.tsinghua.edu.cn/simple" \
        "https://mirrors.aliyun.com/pypi/simple"; do
        log_msg "尝试镜像: ${MIRROR}"
        if run_as_user env PIP_DISABLE_PIP_VERSION_CHECK=1 \
            "${VENV_DIR}/bin/python" -m pip install \
            --timeout 20 --retries 1 --disable-pip-version-check -i "${MIRROR}" -r "${REQ_FILE}"; then
            return 0
        fi
    done
    return 1
}

prepare_venv() {
    mkdir -p "${VAR_DIR}"
    if [ ! -x "${VENV_DIR}/bin/python" ]; then
        log_msg "创建 venv: ${VENV_DIR}"
        run_as_user "${PYTHON}" -m venv "${VENV_DIR}"
    fi
    if deps_ok; then
        return 0
    fi
    # 首选路径：依赖随包内置，离线安装，不依赖网络也不受网络波动影响
    if install_deps_offline && deps_ok; then
        log_msg "依赖就绪（离线，来自包内内置轮子）"
        return 0
    fi
    log_msg "⚠ 内置轮子离线安装未成功，降级为联网安装（最后兜底，正常不该走到这里）"
    if install_deps_online && deps_ok; then
        log_msg "依赖就绪（联网兜底）"
        return 0
    fi
    log_msg "依赖安装失败"
    return 1
}

ensure_fpcalc_exec() {
    # 内置 fpcalc 的执行位兜底：打包/解包环节若把 +x 丢掉，这里补回来。
    # 缺目录就静默返回，真正的缺失由 fingerprint.py 自己报错，不在这里拦启动。
    [ -d "${FPCALC_DIR}" ] || return 0
    chmod +x "${FPCALC_DIR}"/fpcalc-* 2>/dev/null || true
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi
    # 依赖没装好就不要硬启：否则只会得到一个「启动了但立刻退出」的状态，
    # 日志里看不出真正原因。这里直接失败并把原因留在 info.log。
    if ! prepare_venv; then
        log_msg "依赖未就绪，放弃启动（详见上方依赖安装日志）"
        return 1
    fi
    # 内置 fpcalc（音频指纹）：补执行位；目录缺失只记一行提示，不影响启动
    if [ -d "${FPCALC_DIR}" ]; then
        ensure_fpcalc_exec
    else
        log_msg "提示：包内未找到 fpcalc（${FPCALC_DIR}），指纹模式将回退到系统 fpcalc"
    fi
    log_msg "启动应用 (socket=${SOCK_FILE}) ..."
    # 安装向导值（wizard/install、wizard/config）→ 同名环境变量 → 转发给 run_server：
    # 音乐目录（必填）、插件目录（必填）、AcoustID Key（可选，可留空）
    MMW_DB="${VAR_DIR}/app.db" \
    MMW_MUSIC_DIR="${wizard_music_dir:-}" \
    MMW_PLUGINS_DIR="${wizard_plugins_dir:-}" \
    MMW_ACOUSTID_KEY="${wizard_acoustid_key:-}" \
    MMW_CACHE_DIR="${wizard_cache_dir:-}" \
    run_as_user nohup "${VENV_DIR}/bin/python" "${DEST_DIR}/server/run_server.py" "${SOCK_FILE}" \
        >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    sleep 2
    if status; then
        log_msg "启动成功"
        return 0
    else
        log_msg "启动失败，请查看日志"
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "停止应用 ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
        fi
        rm -f "${PID_FILE}"
    fi
    # run_server.py 由 runuser 包裹启动，PID_FILE 记录的是 runuser 的 pid；
    # 一并按命令行终止实际 Python 进程，避免每次重启残留一个实例
    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -f "${DEST_DIR}/server/run_server.py" 2>/dev/null
        local count=0
        while pkill -0 -f "${DEST_DIR}/server/run_server.py" >/dev/null 2>&1 && [ $count -lt 15 ]; do
            sleep 1
            count=$((count + 1))
        done
        pkill -KILL -f "${DEST_DIR}/server/run_server.py" 2>/dev/null
        sleep 1
    fi
    rm -f "${SOCK_FILE}"
    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
